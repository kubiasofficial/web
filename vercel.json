{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/ubd/:path*",
      "destination": "https://ubd-bot.suslik-kuba.workers.dev/:path*"
    },
    {
      "source": "/assets/scarlett.png",
      "destination": "/assets/annie-v2.png"
    },
    {
      "source": "/assets/icon-scarlett.png",
      "destination": "/assets/icon-annie-v2.png"
    },
    {
      "source": "/assets/scarlett-scenes.png",
      "destination": "/assets/annie-scenes-v2.png"
    },
    {
      "source": "/assets/postavy.png",
      "destination": "/assets/station-empty-v4.png"
    },
    {
      "source": "/assets/postavy-annie-v2.png",
      "destination": "/assets/station-empty-v4.png"
    }
  ],
  "headers": [
    {
      "source": "/api/ubd/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/site.21731baf2bec.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/optimized/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media.0dc233c19ee9.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/reader.a6a9821fc125.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app.e1ee6d319a99.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/motion.a5ca7428efb8.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
