{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/ubd/:path*",
      "destination": "https://ubd-bot.suslik-kuba.workers.dev/:path*"
    },
    {
      "source": "/assets/scarlett.png",
      "destination": "/assets/annie-v2.png"
    },
    {
      "source": "/assets/icon-scarlett.png",
      "destination": "/assets/icon-annie-v2.png"
    },
    {
      "source": "/assets/scarlett-scenes.png",
      "destination": "/assets/annie-scenes-v2.png"
    },
    {
      "source": "/assets/postavy.png",
      "destination": "/assets/station-empty-v4.png"
    },
    {
      "source": "/assets/postavy-annie-v2.png",
      "destination": "/assets/station-empty-v4.png"
    }
  ],
  "headers": [
    {
      "source": "/api/ubd/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/music-library.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/site.d15a47bc7f19.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/optimized/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/music/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media.8529442a1b39.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/reader.a6a9821fc125.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/public-people.b73668872e2d.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app.4e6b2cec9ea2.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/motion.66e067f7442b.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/players.c49db5cdd069.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
