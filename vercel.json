{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/ubd/:path*",
      "destination": "https://ubd-bot.suslik-kuba.workers.dev/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/ubd/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/site.9087b202fc6d.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/optimized/:path*",
      "headers": [
